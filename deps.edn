{:paths ["src"]
 ;; Composition, not reimplementation: gossip/bitswap SEMANTICS come from
 ;; kotoba-lang/net, chain walk/verify from chain, CID-verified ingest +
 ;; the generic tag-42 hydrate walk from kotoba-client (ipld transitively).
 ;;
 ;; chain pin note (2026-07-07): previously pinned a pre-rename SHA whose
 ;; own source still used the old commit-dag.core namespace internally
 ;; (ADR-2607050800 renamed the coordinate but that SHA predated the
 ;; internal file rename too). That looked harmless in isolation, but
 ;; broke composition for real: any consumer also depending on chain at a
 ;; POST-rename SHA (e.g. kotoba-lang/kotoba-rad) forces tools.deps to
 ;; resolve one version for the whole classpath, and picking the newer one
 ;; made this repo's own `(:require [commit-dag.core :as cd])` fail to
 ;; resolve -- caught by combining kotoba-rad + kotoba-lang/p2p on one
 ;; classpath for real, not from either repo's own isolated test suite.
 ;; Now pinned to the same SHA kotoba-rad uses, source updated to require
 ;; chain.core (API-compatible: commit!/chain/head/verify-chain unchanged
 ;; by the rename).
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/io-libp2p
        {:git/url "https://github.com/kotoba-lang/io-libp2p.git"
         :git/sha "4a041d4fba4df369cdb8939d167a7e822b8b7d67"}
        io.github.kotoba-lang/chain {:git/sha "fa099efdcafddf7b82d479aca8ff12c845be24e2"}
        io.github.kotoba-lang/kotoba-client {:git/sha "92cbadab8e17eef963d948306b46b2fa54874106"}
        io.github.kotoba-lang/io-ipld {:git/sha "48ba40490cf082a1473986ac757b8e2b214a3d1b"}
        io.github.kotoba-lang/prolly-tree
        {:git/sha "3a12dd2b77430007031e408ee8db75d35f1757a1"}
        io.github.kotoba-lang/io-multiformats {:git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; e2e tests sync a REAL kotobase-peer commit chain (kotobase-engine
         ;; until ADR-2607050700) and read it back on the receiver via
         ;; prolly-tree -- these two are test-only.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/kotobase-peer
                      {:git/sha "60d922b9c490546e8df2fa364e30f3fb25d50a59"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
